@model Device
@{ ViewData["Title"] = "Add a device"; }

<h1>Add a device</h1>

<form asp-action="Add" method="post">
    <partial name="_DeviceForm" model="Model" />
    <button class="btn btn-primary">Save</button>
    <a asp-action="Index">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
